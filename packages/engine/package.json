{
  "name": "@shotbeam/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Shotbeam engine: library database, media indexing, voice, rendering, HTTP API.",
  "exports": {
    ".": "./src/index.ts",
    "./paths": "./src/paths.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@msgpack/msgpack": "^3.1.3",
    "@shotbeam/core": "workspace:^",
    "hono": "^4.13.14",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
